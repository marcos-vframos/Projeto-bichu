APP_ORIGIN=https://seu-dominio
DATA_DIR=/data
PORT=8080
NODE_ENV=production
# Gere uma chave com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PILOT_PANEL_KEY=

# Cadastro definitivo: só é habilitado com SMTP configurado e confirmação do e-mail.
PUBLIC_REGISTRATION=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_FROM=
# Inserir a senha de app diretamente na hospedagem; nunca versionar um valor real.
SMTP_PASSWORD=

# Master apenas administrativo. Hash scrypt de 64 bytes e salt hexadecimal de 32 bytes.
# Não reutilizar credenciais entre produção, matriz, beta e testes sujos.
MASTER_ACCESS_EMAIL=
MASTER_ACCESS_SALT=
MASTER_ACCESS_HASH=

# Bucket privado compatível com S3, fora do volume do app.
BACKUP_ENDPOINT=
BACKUP_REGION=auto
BACKUP_BUCKET=
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=
# 32 bytes aleatórios, em hexadecimal. Guardar cópia privada fora da hospedagem.
BACKUP_ENCRYPTION_KEY=
